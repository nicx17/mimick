#, rust-format
msgid "Immich did not return the tag \"{value}\""
msgstr "Immich не вернул метку \"{value}\""

#: src/api_client/tags.rs:83
msgid "Renaming tags needs a newer version of Immich."
msgstr "Для переименования меток требуется более новая версия Immich."

