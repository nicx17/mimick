msgid "Immich could not load library assets"
msgstr "Immich не удалось загрузить файлы библиотеки"

#: src/api_client/errors.rs:107
msgid "Immich could not run the smart library search"
msgstr "Immich не удалось выполнить умный поиск по библиотеке"

#: src/api_client/errors.rs:109
msgid "Immich could not run the metadata library search"
msgstr "Immich не удалось выполнить поиск по метаданным библиотеки"

#: src/api_client/errors.rs:111
msgid "Immich could not download the selected asset"
msgstr "Immich не удалось скачать выбранный файл"

#: src/api_client/errors.rs:112
msgid "Immich could not load library statistics"
msgstr "Immich не удалось загрузить статистику библиотеки"

#: src/api_client/errors.rs:113
msgid "Immich could not load server version information"
msgstr "Immich не удалось загрузить информацию о версии сервера"

#: src/api_client/errors.rs:121
msgid "The Immich request timed out"
msgstr "Время ожидания запроса к Immich истекло"

#: src/api_client/errors.rs:122
msgid "Check network quality and server responsiveness, then retry."
msgstr ""
"Проверьте качество сетевого подключения и отзывчивость сервера, затем "
"повторите попытку."

#: src/api_client/errors.rs:126 src/api_client/mod.rs:415
msgid "Could not reach the Immich server"
msgstr "Не удалось связаться с сервером Immich"

#: src/api_client/errors.rs:128
msgid ""
"Check the configured URLs, your network connection, and whether the server "
"is online."
msgstr ""
"Проверьте настроенные URL-адреса, сетевое подключение и доступность сервера."

#: src/api_client/errors.rs:135
msgid ""
"Retry the request after checking network connectivity and server health."
msgstr ""
"Проверьте сетевое подключение и состояние сервера, затем повторите попытку."

#: src/api_client/errors.rs:144
msgid "The upload request failed before completion"
msgstr "Запрос на загрузку завершился сбоем до его окончания"

#: src/api_client/errors.rs:145
msgid "The album request failed before completion"
msgstr "Запрос альбома завершился сбоем до его окончания"

#: src/api_client/errors.rs:147
msgid "The album creation request failed before completion"
msgstr "Запрос на создание альбома завершился сбоем до его окончания"

#: src/api_client/errors.rs:150
msgid "The album assignment request failed before completion"
msgstr "Запрос на добавление в альбом завершился сбоем до его окончания"

#: src/api_client/errors.rs:152
msgid "The thumbnail request failed before completion"
msgstr "Запрос миниатюры завершился сбоем до его окончания"

#: src/api_client/errors.rs:153
msgid "The library asset request failed before completion"
msgstr "Запрос файлов библиотеки завершился сбоем до его окончания"

#: src/api_client/errors.rs:154
msgid "The smart search request failed before completion"
msgstr "Запрос умного поиска завершился сбоем до его окончания"

#: src/api_client/errors.rs:156
msgid "The metadata search request failed before completion"
msgstr "Запрос поиска по метаданным завершился сбоем до его окончания"

#: src/api_client/errors.rs:159
msgid "The asset download request failed before completion"
msgstr "Запрос на скачивание файла завершился сбоем до его окончания"

#: src/api_client/errors.rs:162
msgid "The library statistics request failed before completion"
msgstr "Запрос статистики библиотеки завершился сбоем до его окончания"

#: src/api_client/errors.rs:165
msgid "The server version request failed before completion"
msgstr "Запрос версии сервера завершился сбоем до его окончания"

#: src/api_client/mod.rs:520
msgid "No active connection"
msgstr "Нет активного подключения"

