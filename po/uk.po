#: src/api_client/albums.rs:70
msgid "Album list is unavailable"
msgstr "Список альбомів недоступний"

#: src/api_client/albums.rs:71
msgid "Reconnect to the Immich server before refreshing albums."
msgstr "Повторно під'єднайтеся до сервера Immich перед оновленням альбомів."

#: src/api_client/albums.rs:176
msgid "Failed to fetch albums"
msgstr "Не вдалося отримати альбоми"

