#: setup/dev.nicx.mimick.desktop:2
#: setup/metainfo/dev.nicx.mimick.metainfo.xml:4
msgid "Mimick"
msgstr "Mimick"

#: setup/dev.nicx.mimick.desktop:3
msgid "Unofficial Immich desktop client and auto-sync agent"
msgstr "Onodhrokrut Immich desktop client ani ap-xik sync agent"

#: setup/dev.nicx.mimick.desktop:10
msgid ""
"Photo;Photos;Picture;Video;Sync;Backup;Upload;Immich;Gallery;Self-hosted;"
msgstr ""
"Fotov;Fotvam;Chitr;Video;Sync;Backup;Upload;Immich;Gallery;Self-hosted;"

#: setup/dev.nicx.mimick.desktop:24
msgid "Upload with Mimick"
msgstr "Mimick vorvim Upload Korat"

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:5
msgid "Back up and browse your photos"
msgstr "Tumchea fotvancho backup korat ani te polleyat"

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:17
msgid ""
"Mimick is a native Linux desktop client for self-hosted Immich servers. It "
"monitors your folders in the background and automatically syncs photos and "
"videos to your server."
msgstr ""
"Mimick self-hosted Immich servers-khatir ek native Linux desktop client asa. "
"Tem fattlean (background) tumchea folderrancher nodor dovorta ani tumchea "
"serveracher fotov ani video ap-xik sync korta."

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:20
msgid ""
"Per-folder sync methods: upload only, download only, or full bidirectional "
"sync with optional deletion mirroring."
msgstr ""
"Dor eka foldera pormonnem sync pothoti: fokot upload, fokot download, vo "
"donuy vattenchi purnn sync zantunt aplea khuxen kaddun uddovpachem mirroring "
"asta."

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:22
msgid ""
"Built-in Library View for browsing your timeline, managing albums, and "
"searching with Smart Search, OCR, and metadata filters."
msgstr ""
"Tumchi timeline pollounk, albumanchem karbhar cholovnk, ani Smart Search, "
"OCR, toxench metadata filters vorvim sodunk bhitor axil'lo Library View."

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:24
msgid ""
"SHA-1 deduplication, parallel upload workers, and offline retry queue for "
"reliable transfers."
msgstr ""
"Bhorvaxeachea transferankhatir SHA-1 deduplication, samantar upload workers, "
"ani offline retry rang."

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:26
msgid ""
"Environment-aware: automatically pauses on battery or metered connections. "
"Configurable quiet hours and per-folder rules."
msgstr ""
"Poryavoronn somzun ghevpi: battery vo metered connections-acher ap-xik "
"thambta. Khaxa quiet hours ani dor foldera pormonnem nemam."

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:28
msgid ""
"Built in Rust with GTK4 and Libadwaita. System tray integration and Flatpak "
"sandbox support."
msgstr ""
"Rust, GTK4 ani Libadwaita vorvim toiar kelam. System tray integration ani "
"Flatpak sandbox asro."

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:31
msgid ""
"Mimick is a community-developed client and is not affiliated with or "
"endorsed by the Immich project."
msgstr ""
"Mimick he eka somazachean vikasit kel'lo client asa ani to Immich project-a "
"lagim kosloi sombondh vo tachi manyotai dhorina."

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:38
msgid "Library View - Photos page with sidebar"
msgstr "Library View - Sidebar soit Fotvampan"

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:43
msgid "Explore page showing People, Places, and Things"
msgstr "Explore pan Lok, Zage, ani Vostu dakoita"

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:48
msgid "Selected album view in dark mode"
msgstr "Kalluk rupant (dark mode) vinchil'lea albumacho dekhavo"

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:53
msgid "Lightbox viewer with details pane"
msgstr "Bariksannichea pane soit Lightbox viewer"

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:58
msgid "OCR search for text inside images"
msgstr "Fotvambhitorlea borvpachi OCR sod"

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:63
msgid "Album sync dialog with upload and download actions"
msgstr "Upload ani download kortutvam soit album sync dialog"

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:68
msgid "Settings - Server connection and watch folders"
msgstr "Manddavoll - Server connection ani watch folders"

#: setup/metainfo/dev.nicx.mimick.metainfo.xml:73
msgid "Status page with sync health dashboard"
msgstr "Sync bholaiki dashboard soit sthiti pan"
