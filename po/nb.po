msgid "Immich rejected a file as too large"
msgstr "Immich avviste en fil fordi den er for stor"

#: src/api_client/errors.rs:61
msgid ""
"Reduce the file size, raise the server upload limit, or skip oversized files "
"with folder rules."
msgstr ""
"Reduser filstørrelsen, øk tjenerens opplastingsgrense, eller hopp over for "
"store filer med mapperegler."

