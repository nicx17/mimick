#: setup/dev.nicx.mimick.desktop:10
msgid ""
"Photo;Photos;Picture;Video;Sync;Backup;Upload;Immich;Gallery;Self-hosted;"
msgstr "Photo;Photos;Picture;Video;Sync;Backup;Upload;Immich;Gallery;Self-hosted;사진;동영상;비디오;이미지;동기화;백업;업로드;갤러리;셀프호스팅;"

#: setup/dev.nicx.mimick.desktop:25
