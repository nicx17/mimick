msgid "Immich rejected a file as too large"
msgstr "파일 크기가 너무 커서 Immich에서 거부했습니다"

#: src/api_client/errors.rs:61
msgid ""
"Reduce the file size, raise the server upload limit, or skip oversized files "
"with folder rules."
msgstr "파일 크기를 줄이거나, 서버의 업로드 제한을 늘리거나, 폴더 규칙을 사용하여 너무 큰 파일을 건너뛰세요."

